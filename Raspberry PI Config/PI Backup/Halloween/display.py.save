import RPi.GPIO as GPIO
import subprocess
from time import sleep

used = [8, 26, 22, 18, 24, 16, 10]

GPIO.setmode(GPIO.BOARD)

for out in used:
    GPIO.setup(out, GPIO.OUT)
    GPIO.output(out, GPIO.HIGH)

def show(arr):
    count = 0
    for i in arr:
        if i == 0: GPIO.output(used[count], GPIO.HIGH)
        else: GPIO.output(used[count], GPIO.LOW)
        count += 1

player = subprocess.Popen(["aplay", "song.wav"])

show([0, 0, 0, 0, 0, 0, 0])

